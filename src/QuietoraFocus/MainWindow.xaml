                  <TextBox Grid.Column="2" Style="{StaticResource ModernInput}" Text="{Binding NewGameProcessName, UpdateSourceTrigger=PropertyChanged}" Tag="Process Name (e.g. r5apex)"/>
                  <Button Grid.Column="4" Content="+ Add Game" Command="{Binding AddCustomGameCommand}" Style="{StaticResource SecondaryButton}"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Detected Games List -->
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <TextBlock Text="Monitored Games Library" Style="{StaticResource SectionTitle}"/>
