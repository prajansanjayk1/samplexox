                  <TextBlock Text="03 / EXECUTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,4"/>
                  <TextBlock Text="SESSIONS COMPLETED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}"/>
                  <TextBlock Text="{Binding Metrics.CompletedSessionsCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,4,0,2"/>
                  <TextBlock Text="{Binding Metrics.TotalFocusMinutes, StringFormat='{}{0}m all-time flow'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                </StackPanel>
              </Border>

              <!-- 04 SHIELD -->
              <Border Grid.Column="6" Style="{StaticResource CardBorder}">
