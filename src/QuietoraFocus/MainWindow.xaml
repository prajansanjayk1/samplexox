                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="120"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}"/>
                            <TextBlock Text="{Binding SubjectName}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                          </StackPanel>
                          <Border Grid.Column="1" Background="#065F46" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DaysRemaining, StringFormat='⏳ {0} Days Remaining'}" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                          </Border>
                          <TextBlock Grid.Column="2" Text="{Binding TargetScore, StringFormat='Target: {0}%'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add Exam Form -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Style="{StaticResource ModernInput}" Text="{Binding NewExamTitle, UpdateSourceTrigger=PropertyChanged}" Tag="Exam Title (e.g. Midterm 2)"/>
                  <TextBox Grid.Column="2" Style="{StaticResource ModernInput}" Text="{Binding NewExamDaysDue, UpdateSourceTrigger=PropertyChanged}" Tag="Days Due"/>
                  <TextBox Grid.Column="4" Style="{StaticResource ModernInput}" Text="{Binding NewExamTargetScore, UpdateSourceTrigger=PropertyChanged}" Tag="Target %"/>
                  <Button Grid.Column="6" Content="+ Add Exam" Command="{Binding AddExamCommand}" Style="{StaticResource SecondaryButton}"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Spaced Repetition Flashcard Review Deck (SM-2) -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="🧠 Interactive Flashcard Deck (SuperMemo SM-2)" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Interval growth: I(1)=1d, I(2)=6d, I(n)=I(n-1)*EF. Ease factor dynamically recalibrates." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                  </StackPanel>
                  <Border Grid.Column="1" Background="#312E81" CornerRadius="6" Padding="10,4">
                    <TextBlock Text="{Binding AcademicFlashcards.Count, StringFormat='Cards in Deck: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC"/>
                  </Border>
                </Grid>

                <!-- Active Flashcard Reviewer -->
                <Border Background="{DynamicResource ThemeHoverBg}" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="QUESTION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ActiveFlashcard.Question}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- Show Answer Button -->
                    <Button Content="👁️ Show Answer" Command="{Binding RevealFlashcardAnswerCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,14" Visibility="{Binding IsFlashcardAnswerRevealed, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>

                    <!-- Revealed Answer Block -->
                    <StackPanel Visibility="{Binding IsFlashcardAnswerRevealed, Converter={StaticResource BoolToVis}}">
                      <Separator Background="{DynamicResource ThemeInputBorder}" Margin="0,0,0,14"/>
                      <TextBlock Text="ANSWER" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,6"/>
                      <TextBlock Text="{Binding ActiveFlashcard.Answer}" FontSize="15" Foreground="{DynamicResource ThemeTextPrimary}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                      <TextBlock Text="Rate your recall confidence (SM-2):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,8"/>
                      <StackPanel Orientation="Horizontal">
                        <Button Content="1 • Blackout" Command="{Binding ReviewFlashcardRatingCommand}" CommandParameter="1" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Padding="12,8"/>
                        <Button Content="2 • Incorrect" Command="{Binding ReviewFlashcardRatingCommand}" CommandParameter="2" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Padding="12,8"/>
                        <Button Content="3 • Difficult" Command="{Binding ReviewFlashcardRatingCommand}" CommandParameter="3" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,8"/>
                        <Button Content="4 • Good" Command="{Binding ReviewFlashcardRatingCommand}" CommandParameter="4" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,8"/>
                        <Button Content="5 • Perfect" Command="{Binding ReviewFlashcardRatingCommand}" CommandParameter="5" Style="{StaticResource PrimaryButton}" Padding="12,8"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Add New Flashcard Form -->
                <TextBlock Text="Add Flashcard to Deck" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,6"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Style="{StaticResource ModernInput}" Text="{Binding NewFlashcardQuestion, UpdateSourceTrigger=PropertyChanged}" Tag="Question prompt"/>
                  <TextBox Grid.Column="2" Style="{StaticResource ModernInput}" Text="{Binding NewFlashcardAnswer, UpdateSourceTrigger=PropertyChanged}" Tag="Answer text"/>
                  <Button Grid.Column="4" Content="+ Add Card" Command="{Binding AddFlashcardCommand}" Style="{StaticResource SecondaryButton}"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ========================================== -->
          <!-- 20. GROUNDED STUDY AI COMPANION            -->
          <!-- ========================================== -->
          <StackPanel Visibility="{Binding ActivePage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=StudyAI}">
            <TextBlock Text="🧠 Grounded Study AI Companion" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Deterministic, verified academic summaries, practice exam quizzes, and concept explanations. 100% offline-ready." Style="{StaticResource PageSubtitle}"/>

            <!-- Topic Prompt Input & Generation Buttons -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Enter Academic Topic or Concept" Style="{StaticResource SectionTitle}"/>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Style="{StaticResource ModernInput}" Text="{Binding StudyAiTopicInput, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Virtual Memory &amp; Paging, Dijkstra Algorithm, Normalization Forms" FontSize="14"/>
                </Grid>

                <StackPanel Orientation="Horizontal">
                  <Button Content="📚 Grounded Summary" Command="{Binding GenerateStudySummaryCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                  <Button Content="📝 Practice Exam Quiz" Command="{Binding GeneratePracticeQuizCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                  <Button Content="🧠 Explain Concept &amp; Formulas" Command="{Binding ExplainConceptCommand}" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Output Display Card -->
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <TextBlock Text="Generated Academic Output" Style="{StaticResource SectionTitle}"/>
                <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto">
                  <TextBox Style="{StaticResource ModernInput}" Text="{Binding StudyAiOutput, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontFamily="Consolas, Segoe UI" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}"/>
                </ScrollViewer>
              </StackPanel>
            </Border>
          </StackPanel>

        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- BOTTOM STATUS / NOTIFICATION BAR -->
    <Border Grid.Row="2" Background="{DynamicResource ThemeSidebarBg}" Padding="16,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>

        <!-- In-app dismissible notification banner -->
        <Border Grid.Column="1" Background="#065F46" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="10,3"
                Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding NotificationBannerText}" FontSize="11" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="✕" Command="{Binding DismissNotificationCommand}" Style="{StaticResource SecondaryButton}" Padding="4,1" FontSize="9"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- MINDFUL FRICTION OVERLAY (REGAIN / ONE SEC BREATHING INTERCEPT) -->
    <Grid Grid.RowSpan="3" Background="#B0000000" Visibility="{Binding IsMindfulFrictionActive, Converter={StaticResource BoolToVis}}">
      <Border Width="520" Background="{DynamicResource ThemeCardBg}" BorderBrush="#10B981" BorderThickness="2"
              CornerRadius="16" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center">
          <!-- Calm Pulsing Breathing Orb -->
          <Border Width="72" Height="72" CornerRadius="36" Background="#10B981" Margin="0,0,0,16" HorizontalAlignment="Center">
            <TextBlock Text="🧘" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <TextBlock Text="Take a deep breath..." FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding FrictionCountdownSeconds, StringFormat='Hold and exhale ({0}s)'}" FontSize="13" Foreground="#10B981" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,12"/>

          <TextBlock Text="{Binding FrictionTargetName, StringFormat='You are about to open {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding FrictionPrompt}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,20"/>

          <!-- Conscious Action Buttons -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="🌟 Close &amp; Regain Focus" Command="{Binding AcceptFrictionCloseCommand}" Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,12,0"/>
            <Button Content="⏳ 2-Min Mindful Break" Command="{Binding TakeTwoMinBreakCommand}" Style="{StaticResource SecondaryButton}" Padding="14,8"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- COMMAND PALETTE MODAL OVERLAY (Ctrl+K) -->
    <Grid Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolToVis}}">
      <Border Width="620" MaxHeight="520" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
              CornerRadius="14" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Header -->
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="⚡ Quick Command Palette" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
            <Button Grid.Column="1" Content="✕" Command="{Binding ClosePaletteCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"/>
          </Grid>

          <!-- Search Query Input -->
          <Border Grid.Row="1" Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="🔍 " FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="14"
                       Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <!-- Filtered Commands List -->
          <ListBox Grid.Row="2" ItemsSource="{Binding FilteredPaletteCommands}" SelectedItem="{Binding SelectedPaletteCommand}"
                   MaxHeight="320" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource ThemeHoverBg}" CornerRadius="8" Padding="12,8" Margin="0,3" Cursor="Hand">
                  <Grid>
                    <Grid.InputBindings>
                      <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.ExecutePaletteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                    </Grid.InputBindings>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="32"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}"/>
                      <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}"/>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Palette Footer Note -->
          <TextBlock Grid.Row="3" Text="Press ESC to close • Click any command to execute instantly" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</Window>
