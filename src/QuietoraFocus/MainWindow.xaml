                  <TextBlock Text="04 / SHIELD" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,4"/>
                  <TextBlock Text="DOOMSCROLLS AVERTED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}"/>
                  <TextBlock Text="{Binding DetoxReport.DoomscrollsAvertedToday}" FontSize="28" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,2"/>
                  <TextBlock Text="Impulses intercepted" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                </StackPanel>
              </Border>
            </Grid>

            <!-- Recent Sessions Log Table -->
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <TextBlock Text="Recent Focus History" Style="{StaticResource SectionTitle}"/>
                <ItemsControl ItemsSource="{Binding RecentSessions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource ThemeHoverBg}" CornerRadius="8" Padding="12,9" Margin="0,3">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="140"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="⏱️" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                          <TextBlock Grid.Column="1" Text="{Binding TaskName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2" Text="{Binding Mode}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="3" Text="{Binding ActualMinutes, StringFormat='{}{0}m'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="4" Text="{Binding Status}" FontSize="11" Foreground="#10B981" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="5" Text="{Binding StartTimeUtc, StringFormat='{}{0:MMM dd, HH:mm}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ========================================== -->
          <!-- 5. SETTINGS & SHIELDS                      -->
          <!-- ========================================== -->
          <StackPanel Visibility="{Binding ActivePage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Settings}">
            <TextBlock Text="PREFERENCES &amp; PROTECTION CONFIGURATION" Style="{StaticResource EyebrowText}"/>
            <TextBlock Text="Settings &amp; Distraction Lists" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Configure blocked apps, restricted websites, launch on startup, and aesthetic preferences." Style="{StaticResource PageSubtitle}"/>

            <!-- Blocked Applications -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Distracting Desktop Applications" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Processes automatically minimized during active focus sessions:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,10"/>

                <ItemsControl ItemsSource="{Binding BlockedApps}" Margin="0,0,0,14">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource ThemeHoverBg}" CornerRadius="8" Padding="12,8" Margin="0,3">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                          <Button Grid.Column="1" Content="Remove" Command="{Binding DataContext.RemoveBlockedAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Style="{StaticResource ModernInput}" Text="{Binding NewBlockedAppName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Process name (e.g. discord or steam)"/>
                  <Button Grid.Column="2" Content="+ Add Blocked App" Command="{Binding AddBlockedAppCommand}" Style="{StaticResource PrimaryButton}"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Blocked Websites -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Restricted Websites" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Domains and keywords restricted in browser sessions:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,10"/>

                <ItemsControl ItemsSource="{Binding BlockedWebsites}" Margin="0,0,0,14">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource ThemeHoverBg}" CornerRadius="8" Padding="12,8" Margin="0,3">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <CheckBox IsChecked="{Binding IsActive}" Command="{Binding DataContext.ToggleBlockedWebsiteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                          <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2" Text="{Binding Domain}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                          <Button Grid.Column="3" Content="Remove" Command="{Binding DataContext.RemoveBlockedWebsiteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Domain}" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Style="{StaticResource ModernInput}" Text="{Binding NewBlockedWebsiteDomain, UpdateSourceTrigger=PropertyChanged}" ToolTip="Domain (e.g. twitter.com)"/>
                  <TextBox Grid.Column="2" Style="{StaticResource ModernInput}" Text="{Binding NewBlockedWebsiteKeywords, UpdateSourceTrigger=PropertyChanged}" ToolTip="Keywords (e.g. twitter,x.com)"/>
                  <Button Grid.Column="4" Content="+ Add Blocked Website" Command="{Binding AddBlockedWebsiteCommand}" Style="{StaticResource PrimaryButton}"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Preferences -->
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <TextBlock Text="General Preferences" Style="{StaticResource SectionTitle}"/>
                <StackPanel Margin="0,6,0,0">
                  <CheckBox Content="Launch Quietora Focus at Windows Startup" IsChecked="{Binding IsLaunchAtStartup}" FontSize="12" Margin="0,0,0,10"/>
                  <CheckBox Content="Enable procedural sound alerts on session completion" IsChecked="{Binding SoundAlertsEnabled}" FontSize="12" Margin="0,0,0,14"/>
                  <WrapPanel>
                    <Button Content="🌓 Toggle Obsidian / Warm Paper Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/>
                    <Button Content="⚠️ Wipe All Data &amp; Reset" Command="{Binding WipeAllDataCommand}" Style="{StaticResource DangerButton}"/>
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- 3. BOTTOM STATUS / NOTIFICATION BAR (Quietora Labs Bottom Bar) -->
    <Border Grid.Row="2" Background="{DynamicResource ThemeSidebarBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,1,0,0" Padding="20,0">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource ThemeAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- In-app dismissible notification banner -->
        <Border Grid.Column="1" Background="{DynamicResource ThemeAccentSubtle}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="8" Padding="12,4"
                Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding NotificationBannerText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="✕" Command="{Binding DismissNotificationCommand}" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="10"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- MINDFUL FRICTION OVERLAY (REGAIN / ONE SEC BREATHING INTERCEPT) -->
    <Grid Grid.RowSpan="3" Background="#D0000000" Visibility="{Binding IsMindfulFrictionActive, Converter={StaticResource BoolToVis}}">
      <Border Width="540" Background="{DynamicResource ThemeCardBg}" BorderBrush="#10B981" BorderThickness="2"
              CornerRadius="20" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center">
          <!-- Calm Pulsing Breathing Orb -->
          <Border Width="80" Height="80" CornerRadius="40" Background="#10B981" Margin="0,0,0,16" HorizontalAlignment="Center">
            <TextBlock Text="🧘" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <TextBlock Text="Take a deep breath..." FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding FrictionCountdownSeconds, StringFormat='Inhale... Exhale ({0}s)'}" FontSize="14" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,14"/>

          <Border Background="{DynamicResource ThemeHoverBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,0,14" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Intercepted: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
              <TextBlock Text="{Binding FrictionTargetName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}"/>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding FrictionPrompt}" FontSize="13" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"/>

          <!-- Dopamine Stats Pill -->
          <Border Background="{DynamicResource ThemeAccentSubtle}" CornerRadius="12" Padding="12,6" Margin="0,0,0,22">
            <TextBlock Text="✨ Study more, scroll less • Rewire dopamine habits" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Center"/>
          </Border>

          <!-- Conscious Action Buttons -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="🌟 Back to Studying (+5m saved)" Command="{Binding AcceptFrictionCloseCommand}" Style="{StaticResource PrimaryButton}" Padding="18,10" Margin="0,0,12,0"/>
            <Button Content="⏳ 2-Min Mindful Break" Command="{Binding TakeTwoMinBreakCommand}" Style="{StaticResource SecondaryButton}" Padding="16,10"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- COMMAND PALETTE MODAL OVERLAY (Ctrl+K) -->
    <Grid Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolToVis}}">
      <Border Width="620" MaxHeight="520" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
              CornerRadius="14" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Header -->
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="⚡ Quick Command Palette" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
            <Button Grid.Column="1" Content="✕" Command="{Binding ClosePaletteCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"/>
          </Grid>

          <!-- Search Input -->
          <TextBox Grid.Row="1" Style="{StaticResource ModernInput}" Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="14" Margin="0,0,0,12" ToolTip="Type a command or page name..."/>

          <!-- Commands List -->
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <ListBox ItemsSource="{Binding FilteredPaletteCommands}" SelectedItem="{Binding SelectedPaletteCommand}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource ThemeHoverBg}" CornerRadius="8" Padding="12,9" Margin="0,2">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>

          <!-- Execute Button -->
          <Button Grid.Row="3" Content="Execute Command" Command="{Binding ExecutePaletteCommand}" Style="{StaticResource PrimaryButton}"/>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</Window>