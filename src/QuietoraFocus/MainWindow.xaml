                    <TextBlock Text="Create a Study Room" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Style="{StaticResource ModernInput}" Text="{Binding NewRoomNameInput, UpdateSourceTrigger=PropertyChanged}" Tag="Room Name"/>
                      <TextBox Grid.Column="2" Style="{StaticResource ModernInput}" Text="{Binding NewRoomSubjectInput, UpdateSourceTrigger=PropertyChanged}" Tag="Subject"/>
                    </Grid>
                    <Grid Margin="0,0,0,14">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="110"/>
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Style="{StaticResource ModernInput}" Text="{Binding NewRoomObjectiveInput, UpdateSourceTrigger=PropertyChanged}" Tag="Study Objective"/>
                      <TextBox Grid.Column="2" Style="{StaticResource ModernInput}" Text="{Binding NewRoomMinutesInput, UpdateSourceTrigger=PropertyChanged}" Tag="Minutes"/>
                    </Grid>
                    <Button Content="✨ Create 6-Char Study Room" Command="{Binding CreateTogetherRoomCommand}" Style="{StaticResource PrimaryButton}"/>

                    <Separator Background="{DynamicResource ThemeInputBorder}" Margin="0,16"/>

                    <TextBlock Text="Or Join via Room Code" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Style="{StaticResource ModernInput}" Text="{Binding JoinRoomCodeInput, UpdateSourceTrigger=PropertyChanged}" Tag="Enter 6-Char Code (e.g. DSA901)"/>
                      <Button Grid.Column="2" Content="🚀 Join Room" Command="{Binding JoinTogetherRoomCommand}" Style="{StaticResource SecondaryButton}"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- If In Room: Active Room Display -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Visibility="{Binding IsInTogetherRoom, Converter={StaticResource BoolToVis}}">
                  <StackPanel>
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding TogetherRoom.RoomName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
