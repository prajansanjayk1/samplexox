<Window x:Class="QuietoraFocus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuietoraFocus.ViewModels"
        xmlns:models="clr-namespace:QuietoraFocus.Core.Models;assembly=QuietoraFocus.Core"
        Title="quietora. focus — Regain Edition • Study more, scroll less" Width="1280" Height="820"
        MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeWindowBg}" FontFamily="Segoe UI"
        Closing="Window_Closing">

  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>

  <Window.InputBindings>
    <KeyBinding Modifiers="Control" Key="K" Command="{Binding OpenPaletteCommand}"/>
    <KeyBinding Key="Escape" Command="{Binding ClosePaletteCommand}"/>
  </Window.InputBindings>

  <Grid>
    <!-- ROOT GRID (3 ROWS: Header, Content, Status Bar) -->
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="36"/>
    </Grid.RowDefinitions>

    <!-- 1. TOP HEADER (Quietora Labs Design System) -->
    <Border Grid.Row="0" Background="{DynamicResource ThemeSidebarBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1" Padding="20,0">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Brand Logo: Official Quietora Labs Monogram Aperture -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="12" Background="#161820" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" Margin="0,0,12,0" VerticalAlignment="Center">
            <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
              <!-- Outer Aperture Circle -->
              <Ellipse Width="16" Height="16" Canvas.Left="2" Canvas.Top="2" Stroke="#FFFFFF" StrokeThickness="2.4"/>
              <!-- Quietora Coral Core Dot -->
              <Ellipse Width="6" Height="6" Canvas.Left="7" Canvas.Top="7" Fill="{DynamicResource ThemeAccent}"/>
              <!-- Q Aperture Tail -->
              <Line X1="13" Y1="13" X2="20" Y2="20" Stroke="#FFFFFF" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="quietora" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
              <TextBlock Text="." FontSize="24" FontWeight="Black" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,-4,2,0"/>
              <TextBlock Text="focus" FontSize="19" FontWeight="Light" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
              <!-- Regain Motto Badge -->
              <Border Background="{DynamicResource ThemeAccentSubtle}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="STUDY MORE, SCROLL LESS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}"/>
              </Border>
            </StackPanel>
            <TextBlock Text="The Windows Focus Timer &amp; Screen Time Manager • 100% Private" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,1,0,0"/>
          </StackPanel>
        </StackPanel>

        <!-- Center Bar: Ambient Soundscape Quick-Controller & Command Palette -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <!-- Command Palette Button (Glassmorphic) -->
          <Button Command="{Binding OpenPaletteCommand}" Background="{DynamicResource ThemeHoverBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                  Padding="14,6" Margin="0,0,10,0" Cursor="Hand" Style="{StaticResource SecondaryButton}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="🔍  Search or command  " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
              <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                <TextBlock Text="Ctrl+K" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="10" FontWeight="SemiBold"/>
              </Border>
            </StackPanel>
          </Button>

          <!-- Ambient Sound Quick Selector Pill -->
          <Border Background="{DynamicResource ThemeHoverBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="18" Padding="10,4" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="🎧 Ambient:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox SelectedValue="{Binding SelectedAmbientSound}" Width="135" Height="24" FontSize="11" Margin="0,0,6,0"
                        Background="{DynamicResource ThemeInputBg}" Foreground="{DynamicResource ThemeTextPrimary}">
                <models:AmbientSoundType>None</models:AmbientSoundType>
                <models:AmbientSoundType>BrownNoise</models:AmbientSoundType>
                <models:AmbientSoundType>GentleRain</models:AmbientSoundType>
                <models:AmbientSoundType>WhiteNoise</models:AmbientSoundType>
                <models:AmbientSoundType>BinauralGamma40Hz</models:AmbientSoundType>
                <models:AmbientSoundType>BinauralAlpha10Hz</models:AmbientSoundType>
              </ComboBox>
              <Button Content="{Binding IsAmbientSoundPlaying, Converter={StaticResource BoolToVis}, ConverterParameter=invert, FallbackValue='▶'}"
                      Command="{Binding ToggleAmbientSoundCommand}" Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10"/>
            </StackPanel>
          </Border>

          <!-- Active Timer Pill with Flow State -->
          <Border Background="{DynamicResource ThemeAccentSubtle}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="18" Padding="14,5"
                  Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="IN FLOW • " Foreground="{DynamicResource ThemeAccent}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding TimerDisplay}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Right Header Status Badges & Controls -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Strict Mode Toggle Badge -->
          <Button Command="{Binding ToggleStrictModeCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0"
                  ToolTip="Toggle Strict Anti-Cheat Lock (Zero Loopholes)">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="🔒 " FontSize="11" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding StrictModeStatusText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}"/>
            </StackPanel>
          </Button>

          <!-- YouTube Study Mode Toggle Badge -->
          <Button Command="{Binding ToggleYouTubeStudyModeCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,8,0"
                  ToolTip="Toggle YouTube Study Mode (Blocks Shorts, keeps lectures)">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="📺 Study Mode" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
            </StackPanel>
          </Button>

          <!-- Theme Toggle Button -->
          <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,8,0" ToolTip="Toggle Dark / Warm Paper Theme">
            <TextBlock Text="🌓" FontSize="13" VerticalAlignment="Center"/>
          </Button>
          <Button Content="Quick Focus" Command="{Binding QuickStartCommand}" Style="{StaticResource PrimaryButton}" Padding="14,6" FontSize="11"
                  Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 2. MAIN BODY: SIDEBAR + CONTENT -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- STREAMLINED LEFT SIDEBAR (5 Core Focused Sections) -->
      <Border Grid.Column="0" Background="{DynamicResource ThemeSidebarBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,1,0" Padding="12,14">
        <DockPanel LastChildFill="True">
          <!-- Bottom Brand / Version -->
          <Border DockPanel.Dock="Bottom" Background="{DynamicResource ThemeHoverBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,10,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="quietora" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                <TextBlock Text="." FontSize="14" FontWeight="Black" Foreground="{DynamicResource ThemeAccent}" Margin="0,-3,2,0"/>
                <TextBlock Text="focus" FontSize="11" FontWeight="Light" Foreground="{DynamicResource ThemeTextSecondary}"/>
              </StackPanel>
              <TextBlock Text="Regain Edition • Study more, scroll less" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}"/>
            </StackPanel>
          </Border>

          <!-- Navigation Links -->
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="CORE WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="12,4,0,8"/>

              <!-- 1. Focus Studio -->
              <Button Content="⏱️   Focus Studio" Command="{Binding NavigateCommand}" CommandParameter="Focus" Style="{StaticResource NavButton}"
                      Background="{Binding ActivePage, Converter={StaticResource NavBgConverter}, ConverterParameter=Focus}"
                      Foreground="{Binding ActivePage, Converter={StaticResource NavFgConverter}, ConverterParameter=Focus}"
                      BorderBrush="{Binding ActivePage, Converter={StaticResource NavBorderConverter}, ConverterParameter=Focus}"
                      FontWeight="{Binding ActivePage, Converter={StaticResource NavWeightConverter}, ConverterParameter=Focus}"/>

              <!-- 2. Screen Time & Limits -->
              <Button Content="🧘   Screen Time &amp; Limits" Command="{Binding NavigateCommand}" CommandParameter="Detox" Style="{StaticResource NavButton}"
                      Background="{Binding ActivePage, Converter={StaticResource NavBgConverter}, ConverterParameter=Detox}"
                      Foreground="{Binding ActivePage, Converter={StaticResource NavFgConverter}, ConverterParameter=Detox}"
                      BorderBrush="{Binding ActivePage, Converter={StaticResource NavBorderConverter}, ConverterParameter=Detox}"
                      FontWeight="{Binding ActivePage, Converter={StaticResource NavWeightConverter}, ConverterParameter=Detox}"/>

              <!-- 3. Shorts & Reels Shield -->
              <Button Content="🚫   Shorts &amp; Reels Shield" Command="{Binding NavigateCommand}" CommandParameter="Shorts" Style="{StaticResource NavButton}"
                      Background="{Binding ActivePage, Converter={StaticResource NavBgConverter}, ConverterParameter=Shorts}"
                      Foreground="{Binding ActivePage, Converter={StaticResource NavFgConverter}, ConverterParameter=Shorts}"
                      BorderBrush="{Binding ActivePage, Converter={StaticResource NavBorderConverter}, ConverterParameter=Shorts}"
                      FontWeight="{Binding ActivePage, Converter={StaticResource NavWeightConverter}, ConverterParameter=Shorts}"/>

              <!-- 4. Productivity Pulse & History -->
              <Button Content="📊   Analytics &amp; Pulse" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource NavButton}"
                      Background="{Binding ActivePage, Converter={StaticResource NavBgConverter}, ConverterParameter=Dashboard}"
                      Foreground="{Binding ActivePage, Converter={StaticResource NavFgConverter}, ConverterParameter=Dashboard}"
                      BorderBrush="{Binding ActivePage, Converter={StaticResource NavBorderConverter}, ConverterParameter=Dashboard}"
                      FontWeight="{Binding ActivePage, Converter={StaticResource NavWeightConverter}, ConverterParameter=Dashboard}"/>

              <Separator Background="{DynamicResource ThemeCardBorder}" Margin="6,12"/>

              <TextBlock Text="SYSTEM &amp; PROTECTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="12,4,0,8"/>

              <!-- 5. Settings & Shields -->
              <Button Content="⚙️   Settings &amp; Shields" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource NavButton}"
                      Background="{Binding ActivePage, Converter={StaticResource NavBgConverter}, ConverterParameter=Settings}"
                      Foreground="{Binding ActivePage, Converter={StaticResource NavFgConverter}, ConverterParameter=Settings}"
                      BorderBrush="{Binding ActivePage, Converter={StaticResource NavBorderConverter}, ConverterParameter=Settings}"
                      FontWeight="{Binding ActivePage, Converter={StaticResource NavWeightConverter}, ConverterParameter=Settings}"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- STREAMLINED CONTENT AREA (5 Essential Clean Pages) -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,22">
        <Grid>

          <!-- ========================================== -->
          <!-- 1. FOCUS STUDIO (HERO ATTENTION ENGINE)    -->
          <!-- ========================================== -->
          <StackPanel Visibility="{Binding ActivePage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Focus}">
            <TextBlock Text="SYSTEMS &amp; HUMAN-INTERFACE STUDIO • REGAIN ON WINDOWS" Style="{StaticResource EyebrowText}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <TextBlock Text="Study more. " FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
              <TextBlock Text="Scroll less." FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" FontStyle="Italic"/>
            </StackPanel>
            <TextBlock Text="The focus timer that helps you study more and scroll less. Lock in your session, block addictive feeds, and eliminate doomscrolling on Windows." Style="{StaticResource PageSubtitle}"/>

            <!-- Interactive Mode Pill Segmented Selector & Regain Anti-Cheat Bar -->
            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <!-- Mode Pills -->
              <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="24" Padding="6,5" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <Button Content="25 min Focus" Command="{Binding SetTimerPresetCommand}" CommandParameter="25" Style="{StaticResource SegmentedPillButton}" Margin="0,0,6,0"/>
                  <Button Content="45 min Deep Work" Command="{Binding SetTimerPresetCommand}" CommandParameter="45" Style="{StaticResource SegmentedPillButton}" Margin="0,0,6,0"/>
                  <Button Content="50 min Block" Command="{Binding SetTimerPresetCommand}" CommandParameter="50" Style="{StaticResource SegmentedPillButton}" Margin="0,0,6,0"/>
                  <Button Content="5 min Break" Command="{Binding SetTimerPresetCommand}" CommandParameter="5" Style="{StaticResource SegmentedPillButton}" Margin="0,0,6,0"/>
                  <Button Content="15 min Reset" Command="{Binding SetTimerPresetCommand}" CommandParameter="15" Style="{StaticResource SegmentedPillButton}"/>
                </StackPanel>
              </Border>

              <!-- Regain Zero-Loophole Switches -->
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Strict Mode Toggle -->
                <Button Command="{Binding ToggleStrictModeCommand}" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,10,0"
                        ToolTip="When Strict Mode is ON, session cannot be ended early or bypassed.">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔒 Strict Mode: " FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                    <TextBlock Text="{Binding StrictModeStatusText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}"/>
                  </StackPanel>
                </Button>

                <!-- YouTube Study Mode Toggle -->
                <Button Command="{Binding ToggleYouTubeStudyModeCommand}" Style="{StaticResource SecondaryButton}" Padding="12,7"
                        ToolTip="Blocks YouTube Shorts &amp; algorithmic recommendations; keeps lectures &amp; educational search open.">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📺 YouTube Study Mode" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Left Column: Flagship Timer Card & Controls -->
              <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                  <!-- Card Header Bar -->
                  <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="quietora" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                      <TextBlock Text="." FontSize="18" FontWeight="Black" Foreground="{DynamicResource ThemeAccent}" Margin="0,-3,2,0"/>
                      <TextBlock Text="focus" FontSize="14" FontWeight="Light" Foreground="{DynamicResource ThemeTextSecondary}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource ThemeHoverBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource ThemeAccent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TimerSubText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}"/>
                      </StackPanel>
                    </Border>
                  </Grid>

                  <!-- Hero Clock Display with Glow -->
                  <Border Background="{DynamicResource ThemeHoverBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="20" Padding="28,24" Margin="0,0,0,18">
                    <StackPanel HorizontalAlignment="Center">
                      <!-- Big Tabular Display -->
                      <TextBlock Text="{Binding TimerDisplay}" FontSize="82" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center"/>
                      <TextBlock Text="Study more, scroll less • Round 1 of 4" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,16"/>

                      <!-- Coral Gradient Progress Bar -->
                      <Border Width="380" Height="8" CornerRadius="4" Background="{DynamicResource ThemeInputBorder}" ClipToBounds="True">
                        <ProgressBar Value="{Binding TimerProgress, Mode=OneWay}" Height="8" Width="380" Minimum="0" Maximum="100" Foreground="{DynamicResource ThemeAccent}" BorderThickness="0" Background="Transparent"/>
                      </Border>
                    </StackPanel>
                  </Border>

                  <!-- Strict Mode Zero Loopholes Warning Banner (Visible when session is active and strict) -->
                  <Border Background="{DynamicResource ThemeHoverBg}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,16"
                          Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVis}}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="🔒" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="STRICT MODE ENGAGED — Anti-cheat shield active. Quitting early is disabled to protect your flow." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>

                  <!-- Secondary Status Chips -->
                  <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource ThemeHoverBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="10,6" HorizontalAlignment="Left">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎧 Ambient: " FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        <TextBlock Text="{Binding SelectedAmbientSound}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource ThemeHoverBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="10,6">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔥 " FontSize="11"/>
                        <TextBlock Text="{Binding Metrics.TodayFocusMinutes, StringFormat='{}{0}m focused today'}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                      </StackPanel>
                    </Border>
                  </Grid>

                  <!-- Inputs -->
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="2*"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Objective / Goal" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                      <TextBox Style="{StaticResource ModernInput}" Text="{Binding CurrentTaskInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Subject / Category" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                      <TextBox Style="{StaticResource ModernInput}" Text="{Binding CurrentSubjectInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                  </Grid>

                  <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Minutes" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                      <TextBox Style="{StaticResource ModernInput}" Text="{Binding SessionMinutesInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Session Notes (optional)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                      <TextBox Style="{StaticResource ModernInput}" Text="{Binding SessionNotesInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                  </Grid>

                  <!-- Action Buttons -->
                  <WrapPanel Margin="0,0,0,14">
                    <Button Content="Start session ➔" Command="{Binding StartSessionCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8" Padding="22,11"/>
                    <Button Content="Pause ⏸" Command="{Binding PauseSessionCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                    <Button Content="Resume ▶" Command="{Binding ResumeSessionCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                    <Button Content="Reset ↺" Command="{Binding ResetTimerCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                    <Button Content="End Session ⏹" Command="{Binding StopSessionCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                    <Button Content="Emergency Stop 🚨" Command="{Binding EmergencyStopCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,8"/>
                  </WrapPanel>

                  <!-- 3 Step Boxes: 01/Set, 02/Protect, 03/Reflect -->
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource ThemeHoverBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                      <StackPanel>
                        <TextBlock Text="01 / SET" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,3"/>
                        <TextBlock Text="Pick a priority" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                        <TextBlock Text="Decide what truly deserves your attention." FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource ThemeHoverBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                      <StackPanel>
                        <TextBlock Text="02 / PROTECT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,3"/>
                        <TextBlock Text="Make room to work" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                        <TextBlock Text="Silence tempting detours and background feeds." FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="{DynamicResource ThemeHoverBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                      <StackPanel>
                        <TextBlock Text="03 / REFLECT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,3"/>
                        <TextBlock Text="Build lasting rhythm" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                        <TextBlock Text="Notice your focus intervals and consistency." FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Border>
                  </Grid>

                </StackPanel>
              </Border>

              <!-- Right Column: Ambient Audio Soundscapes -->
              <StackPanel Grid.Column="2">
                <!-- Soundscape Card -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="🎧 Ambient Focus Soundscapes" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Synthesized procedurally in pure .NET without external downloads:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,10"/>

                    <WrapPanel Margin="0,0,0,10">
                      <Button Content="☕ Cozy Lofi" Command="{Binding SelectAmbientSoundCommand}" CommandParameter="BrownNoise" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="11" Margin="0,0,6,6"/>
                      <Button Content="🌧️ Gentle Rain" Command="{Binding SelectAmbientSoundCommand}" CommandParameter="GentleRain" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="11" Margin="0,0,6,6"/>
                      <Button Content="🧠 40Hz Gamma" Command="{Binding SelectAmbientSoundCommand}" CommandParameter="BinauralGamma40Hz" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="11" Margin="0,0,6,6"/>
                      <Button Content="🌊 10Hz Alpha" Command="{Binding SelectAmbientSoundCommand}" CommandParameter="BinauralAlpha10Hz" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="11" Margin="0,0,6,6"/>
                      <Button Content="🔇 Mute Audio" Command="{Binding SelectAmbientSoundCommand}" CommandParameter="None" Style="{StaticResource DangerButton}" Padding="12,6" FontSize="11" Margin="0,0,0,6"/>
                    </WrapPanel>

