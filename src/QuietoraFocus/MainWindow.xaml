                        <Button Content="▶️ Start Authoritative Timer" Command="{Binding StartTogetherSessionCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Border>

                    <!-- Participants List -->
                    <TextBlock Text="Room Members" Style="{StaticResource SectionTitle}"/>
