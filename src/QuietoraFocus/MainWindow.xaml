                </Grid>

                <!-- Budgets List -->
                <ItemsControl ItemsSource="{Binding AppBudgets}" Margin="0,0,0,16">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource ThemeHoverBg}" CornerRadius="10" Padding="14,10" Margin="0,4">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <CheckBox IsChecked="{Binding IsActive}" Command="{Binding DataContext.ToggleBudgetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}"/>
                            <TextBlock Text="{Binding TargetName}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                          </StackPanel>

                          <!-- Progress Bar -->
                          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                            <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Height="7" Maximum="100"
                                         Foreground="{Binding IsQuotaExceeded, Converter={StaticResource PriorityColor}}"/>
                            <TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0"/>
                          </StackPanel>

                          <!-- Time used text -->
                          <TextBlock Grid.Column="3" Text="{Binding UsedMinutesToday, StringFormat='{}{0} / '}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                          <TextBlock Grid.Column="3" Text="{Binding DailyLimitMinutes, StringFormat='{}{0}m'}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="30,0,0,0"/>

                          <Button Grid.Column="4" Content="Delete" Command="{Binding DataContext.DeleteBudgetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Id}" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10" Margin="10,0,0,0"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add New Budget Form -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Style="{StaticResource ModernInput}" Text="{Binding NewBudgetTargetName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Domain or Process (e.g. instagram.com or discord)"/>
                  <TextBox Grid.Column="2" Style="{StaticResource ModernInput}" Text="{Binding NewBudgetDisplayName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Friendly Label (e.g. Instagram)"/>
                  <TextBox Grid.Column="4" Style="{StaticResource ModernInput}" Text="{Binding NewBudgetLimitMinutes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Minutes/day (e.g. 30)"/>
                  <Button Grid.Column="6" Content="+ Set Limit" Command="{Binding AddBudgetCommand}" Style="{StaticResource PrimaryButton}"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Intercept Mode Settings -->
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <TextBlock Text="Distraction Interception Behavior" Style="{StaticResource SectionTitle}"/>
                <WrapPanel>
                  <RadioButton Content="🔥 Hardcore / Hell Mode (Closes tab with Ctrl+W and minimizes window in 1s)" IsChecked="{Binding IsHardcoreCloseMode}" GroupName="IntGroup" Margin="0,0,20,8"/>
                  <RadioButton Content="🧘 Mindful Friction (5-second breathing pause &amp; intention check)" IsChecked="{Binding IsMindfulFrictionMode}" GroupName="IntGroup" Margin="0,0,20,8"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ========================================== -->
          <!-- 3. SHORTS & REELS SHIELD (REGAIN SHIELD)   -->
          <!-- ========================================== -->
          <StackPanel Visibility="{Binding ActivePage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Shorts}">
            <TextBlock Text="SELECTIVE FEED BLOCKING" Style="{StaticResource EyebrowText}"/>
            <TextBlock Text="Short-Form Video &amp; Doomscroll Shield" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Laser-targeted blocks for addictive vertical feeds without disabling educational tutorials or work resources." Style="{StaticResource PageSubtitle}"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Targeted Feed Interceptors" Style="{StaticResource SectionTitle}"/>

                <!-- YouTube Study Mode Card -->
                <Border Background="{DynamicResource ThemeHoverBg}" BorderBrush="#10B981" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="📺 YouTube Study Mode (Learn Without Distraction)" FontWeight="Bold" FontSize="13" Foreground="#10B981"/>
                        <Border Background="#065F46" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                          <TextBlock Text="REGAIN STUDY MODE" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Text="Watch educational lectures and tutorials while completely blocking YouTube Shorts, algorithmic home feeds, and recommendations." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Content="Active" IsChecked="{Binding IsYouTubeStudyMode}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                  </Grid>
                </Border>

                <!-- Selective Shorts Only Mode Card -->
                <Border Background="#2A1815" BorderBrush="#E55337" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="🎯 Selective Shorts &amp; Reels Only Mode" FontWeight="Bold" FontSize="13" Foreground="#E55337"/>
                      <TextBlock Text="When enabled, Quietora allows educational YouTube &amp; Instagram messages, but instantly intercepts when you click 'Shorts' or 'Reels'!" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding BlockShortsAndReelsOnly}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                  </Grid>
                </Border>

                <!-- Pre-Configured Feeds Grid -->
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Background="{DynamicResource ThemeHoverBg}" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                      <TextBlock Text="📺 YouTube Shorts" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Intercepts /shorts/ and #shorts video streams in Chrome, Edge, Firefox, Brave." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,8"/>
                      <TextBlock Text="● Shield Active" Foreground="#10B981" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Background="{DynamicResource ThemeHoverBg}" CornerRadius="10" Padding="14" Margin="8,0,0,0">
                    <StackPanel>
                      <TextBlock Text="📸 Instagram Reels &amp; Explore" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Intercepts infinite Reels feeds and algorithmic Explore tabs." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,8"/>
                      <TextBlock Text="● Shield Active" Foreground="#10B981" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Background="{DynamicResource ThemeHoverBg}" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                      <TextBlock Text="🎵 TikTok Web" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Intercepts all TikTok desktop sessions immediately." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,8"/>
                      <TextBlock Text="● Shield Active" Foreground="#10B981" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Background="{DynamicResource ThemeHoverBg}" CornerRadius="10" Padding="14" Margin="8,0,0,0">
                    <StackPanel>
                      <TextBlock Text="🤖 Reddit Endless Feeds" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Blocks r/popular and infinite frontpage doomscrolling." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,8"/>
                      <TextBlock Text="● Shield Active" Foreground="#10B981" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ========================================== -->
          <!-- 4. ANALYTICS & PULSE (PRODUCTIVITY)        -->
          <!-- ========================================== -->
          <StackPanel Visibility="{Binding ActivePage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Dashboard}">
            <TextBlock Text="SYSTEMS &amp; ATTENTION PULSE" Style="{StaticResource EyebrowText}"/>
            <TextBlock Text="Productivity Analytics &amp; Pulse" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Software engineered for deep attention. Transparent, on-device telemetry with zero cloud leakage." Style="{StaticResource PageSubtitle}"/>

            <!-- 4-Card Metric Grid -->
            <Grid Margin="0,0,0,24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- 01 ATTENTION -->
              <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                  <TextBlock Text="01 / ATTENTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,4"/>
                  <TextBlock Text="FOCUSED TODAY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}"/>
                  <TextBlock Text="{Binding Metrics.TodayFocusMinutes, StringFormat='{}{0}m'}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,4,0,2"/>
                  <TextBlock Text="{Binding Metrics.CompletionRate, StringFormat='{}{0:F0}% completion rate'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                </StackPanel>
              </Border>

              <!-- 02 RHYTHM -->
              <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                  <TextBlock Text="02 / RHYTHM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,4"/>
                  <TextBlock Text="ACTIVE STREAK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}"/>
                  <TextBlock Text="{Binding Metrics.CurrentStreakDays, StringFormat='🔥 {0}d'}" FontSize="28" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,2"/>
                  <TextBlock Text="{Binding Metrics.LongestStreakDays, StringFormat='Longest: {0} days'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                </StackPanel>
              </Border>

              <!-- 03 EXECUTION -->
              <Border Grid.Column="4" Style="{StaticResource CardBorder}">
