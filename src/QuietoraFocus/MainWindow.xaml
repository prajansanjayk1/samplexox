                <CheckBox Content="Sound alerts upon session completion" IsChecked="{Binding SoundAlertsEnabled}" Margin="0,0,0,12" FontSize="12" FontWeight="SemiBold"/>
                <CheckBox Content="Block Shorts &amp; Reels Only (Allow educational study videos)" IsChecked="{Binding BlockShortsAndReelsOnly}" Margin="0,0,0,12" FontSize="12" FontWeight="SemiBold"/>
                <CheckBox Content="Enable Night Sleep Shield (22:30 – 07:00 bedtime lockdown)" IsChecked="{Binding BedtimeShieldEnabled}" Margin="0,0,0,16" FontSize="12" FontWeight="SemiBold"/>

                <TextBlock Text="Database Path" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource ModernInput}" Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ========================================== -->
          <!-- 14. GAME SHIELD (GAME RESTRICTION ENGINE)   -->
          <!-- ========================================== -->
          <StackPanel Visibility="{Binding ActivePage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=GameShield}">
