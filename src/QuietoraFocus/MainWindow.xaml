                          </Border>
                          <TextBlock Grid.Column="3" Text="{Binding LastLaunchedUtc, StringFormat='Last: {0}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                          <CheckBox Grid.Column="4" Content="Blocked" IsChecked="{Binding IsBlocked}" Command="{Binding DataContext.ToggleGameBlockedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ========================================== -->
          <!-- 15. SAFE BROWSING & FAMILY DNS             -->
          <!-- ========================================== -->
          <StackPanel Visibility="{Binding ActivePage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=SafeBrowsing}">
            <TextBlock Text="🛡️ Safe Browsing &amp; Adult Content Protection" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Multi-layered protection against explicit websites, adult portals, and malicious advertising across all browsers." Style="{StaticResource PageSubtitle}"/>

            <!-- Browser Shield Extension Connection -->
            <Border Style="{StaticResource CardBorder}" Background="#064E3B" BorderBrush="#059669" Margin="0,0,0,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Browser Shield Native Extension (Manifest V3)" FontSize="15" FontWeight="Bold" Foreground="White"/>
                  <TextBlock Text="Synchronized via loopback port 41789. Blocks adult domains with declarativeNetRequest before network request dispatch." FontSize="12" Foreground="#A7F3D0" Margin="0,2,0,8"/>
                  <CheckBox Content="Enforce Category Adult &amp; Explicit Domain Shield (declarativeNetRequest Priority 2500)" IsChecked="{Binding IsAdultProtectionEnabled}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="🔒" FontSize="36" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <!-- Family-Safe DNS Center -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="System-Wide Family-Safe DNS Resolver" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="DNS filtering automatically prevents adult domain resolution across all network apps, background daemons, and browsers." FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,12"/>

                <ComboBox SelectedIndex="{Binding SelectedDnsProviderIndex}" Height="34" Width="380" HorizontalAlignment="Left" Margin="0,0,0,14">
                  <ComboBoxItem Content="Standard / System Default"/>
                  <ComboBoxItem Content="Cloudflare Family (1.1.1.3 / 1.0.0.3)"/>
                  <ComboBoxItem Content="AdGuard Family (94.140.14.15 / 94.140.15.16)"/>
                  <ComboBoxItem Content="CleanBrowsing (185.228.168.168)"/>
                </ComboBox>

                <TextBlock Text="PowerShell Setup Command (Copy and run as Administrator in PowerShell):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource ModernInput}" Text="{Binding DnsPowerShellCommand, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">
                  <Button Content="📋 Copy DNS Command" Command="{Binding CopyDnsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                  <Button Content="🔄 Reset to DHCP Default" Command="{Binding ResetDnsCommand}" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Honest Protection Notice -->
            <Border Background="{DynamicResource ThemeHoverBg}" BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
              <StackPanel>
                <TextBlock Text="ℹ️ Quietora Safe Browsing Integrity Notice" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,4"/>
                <TextBlock Text="Category-based DNS and browser shields protect against unintentional exposure and impulsive browsing triggers. Technical bypasses (such as VPNs, DoH, or proxy tunnels) are recognized limitations. Quietora pairs voluntary commitment with system protections without installing destabilizing kernel rootkits." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ========================================== -->
          <!-- 16. QUIETORA TOGETHER (STUDY ROOMS)        -->
          <!-- ========================================== -->
          <StackPanel Visibility="{Binding ActivePage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Together}">
            <TextBlock Text="👥 Quietora Together — Collaborative Study Rooms" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Real-time synchronized study sessions with authoritative timers, presence, and zero-leakage privacy." Style="{StaticResource PageSubtitle}"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

