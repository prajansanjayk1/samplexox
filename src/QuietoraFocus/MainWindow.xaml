                                <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                <TextBlock Text="{Binding CurrentTask}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}"/>
                              </StackPanel>
                              <Border Grid.Column="2" Background="#065F46" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="Ready" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Right Column: Room Group Chat -->
              <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="Study Room Chat" Style="{StaticResource SectionTitle}"/>

                  <!-- Chat Messages -->
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,12" MaxHeight="380">
                    <ItemsControl ItemsSource="{Binding TogetherRoom.ChatMessages}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource ThemeHoverBg}" CornerRadius="6" Padding="8,6" Margin="0,3">
                            <StackPanel>
                              <TextBlock Text="{Binding SenderNickname}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeAccent}"/>
                              <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <!-- Chat Input -->
                  <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource ModernInput}" Text="{Binding ChatMessageInput, UpdateSourceTrigger=PropertyChanged}" Tag="Message room..."/>
                    <Button Grid.Column="2" Content="Send" Command="{Binding SendTogetherChatMessageCommand}" Style="{StaticResource PrimaryButton}" Padding="12,8"/>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </StackPanel>

          <!-- ========================================== -->
          <!-- 17. ACADEMIC SYLLABUS & SUBJECT PLANNER    -->
          <!-- ========================================== -->
          <StackPanel Visibility="{Binding ActivePage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Planner}">
            <TextBlock Text="📚 Academic Syllabus &amp; Subject Planner" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Organize university courses, syllabus chapters, study targets, and completion hours." Style="{StaticResource PageSubtitle}"/>

            <!-- Add Subject Form -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Enroll New Subject / Course" Style="{StaticResource SectionTitle}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Style="{StaticResource ModernInput}" Text="{Binding NewSubjectName, UpdateSourceTrigger=PropertyChanged}" Tag="Course Name (e.g. Operating Systems)"/>
                  <TextBox Grid.Column="2" Style="{StaticResource ModernInput}" Text="{Binding NewSubjectCode, UpdateSourceTrigger=PropertyChanged}" Tag="Code (e.g. CS301)"/>
                  <TextBox Grid.Column="4" Style="{StaticResource ModernInput}" Text="{Binding NewSubjectSemester, UpdateSourceTrigger=PropertyChanged}" Tag="Semester"/>
                  <TextBox Grid.Column="6" Style="{StaticResource ModernInput}" Text="{Binding NewSubjectHours, UpdateSourceTrigger=PropertyChanged}" Tag="Target Hrs"/>
                  <Button Grid.Column="8" Content="+ Add Course" Command="{Binding AddSubjectCommand}" Style="{StaticResource PrimaryButton}"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Subjects Cards -->
            <ItemsControl ItemsSource="{Binding AcademicSubjects}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
