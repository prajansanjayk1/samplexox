              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Enforcement Level" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Choose how Quietora Focus responds when a game launches:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,8"/>
