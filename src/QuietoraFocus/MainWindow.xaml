                        <DataTemplate>
                          <Border Background="{DynamicResource ThemeHoverBg}" CornerRadius="8" Padding="10,6" Margin="0,3">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0" Text="{Binding AvatarEmoji}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
