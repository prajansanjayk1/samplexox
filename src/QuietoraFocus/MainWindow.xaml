                      <Border Grid.Column="1" Background="#065F46" CornerRadius="8" Padding="12,6">
                        <TextBlock Text="{Binding TogetherRoom.RoomCode, StringFormat='CODE: {0}'}" FontSize="14" FontWeight="Bold" Foreground="#34D399"/>
                      </Border>
                    </Grid>

                    <!-- Large Synchronized Timer -->
                    <Border Background="{DynamicResource ThemeHoverBg}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TogetherTimerDisplay}" FontSize="48" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Center"/>
