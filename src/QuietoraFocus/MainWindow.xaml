                    <ComboBoxItem Content="Level 1: Detection Reminder (Friendly awareness alert)"/>
                    <ComboBoxItem Content="Level 2: Discouragement &amp; Auto-Minimize (Study discipline)"/>
                    <ComboBoxItem Content="Level 3: Strict Focus Block (Instant minimize)"/>
                  </ComboBox>
                </StackPanel>
                <Button Grid.Column="1" Content="🔍 Scan Installed Games" Command="{Binding ScanGamesCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"/>
