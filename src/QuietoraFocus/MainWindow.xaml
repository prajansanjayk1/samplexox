                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Border Background="{DynamicResource ThemeAccent}" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Code}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                          </Border>
                          <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                          <TextBlock Text="{Binding Semester, StringFormat=' • {0}'}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Delete" Command="{Binding DataContext.DeleteSubjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="8,4" FontSize="11"/>
                      </Grid>

                      <!-- Progress Row -->
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Height="8" Foreground="#10B981" Background="{DynamicResource ThemeInputBorder}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding CompletedHours, StringFormat='{}{0}h studied'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="10,0,0,0"/>
                      </Grid>

                      <!-- Syllabus Topics List -->
                      <TextBlock Text="Syllabus Topics:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
