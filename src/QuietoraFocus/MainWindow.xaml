                    <DataTemplate>
                      <Border Background="{DynamicResource ThemeHoverBg}" CornerRadius="10" Padding="14,10" Margin="0,4">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="🎮" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}"/>
                            <TextBlock Text="{Binding ProcessName, StringFormat='Process: {0}.exe'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                          </StackPanel>
                          <Border Grid.Column="2" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
