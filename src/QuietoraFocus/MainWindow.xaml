                  <TextBlock Text="Upcoming Examination Deadlines" Style="{StaticResource SectionTitle}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding AcademicExams}" Margin="0,0,0,12">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
